# TukiFact API — Multi-stage .NET 10 build
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy solution and project files for layer caching
COPY TukiFact.slnx ./
COPY src/TukiFact.Domain/TukiFact.Domain.csproj src/TukiFact.Domain/
COPY src/TukiFact.Application/TukiFact.Application.csproj src/TukiFact.Application/
COPY src/TukiFact.Infrastructure/TukiFact.Infrastructure.csproj src/TukiFact.Infrastructure/
COPY src/TukiFact.Api/TukiFact.Api.csproj src/TukiFact.Api/
COPY Directory.Build.props Directory.Packages.props global.json ./

# Kernel (src/Common, src/BuildingBlocks): TukiFact.Api references these so their
# csproj files and the nested Directory.Build.props that scope TreatWarningsAsErrors must be present
# before restore. Explicit COPY lines (not a directory copy) keep the layer-caching intent of the
# legacy lines above and fail loudly — a missing project here is a missing COPY line, not a runtime
# restore surprise.
COPY src/Common/Directory.Build.props src/Common/
COPY src/Common/TukiFact.Common.Domain/TukiFact.Common.Domain.csproj src/Common/TukiFact.Common.Domain/
COPY src/Common/TukiFact.Common.Application/TukiFact.Common.Application.csproj src/Common/TukiFact.Common.Application/
COPY src/Common/TukiFact.Common.Infrastructure/TukiFact.Common.Infrastructure.csproj src/Common/TukiFact.Common.Infrastructure/
COPY src/Common/TukiFact.Common.Presentation/TukiFact.Common.Presentation.csproj src/Common/TukiFact.Common.Presentation/
COPY src/BuildingBlocks/Directory.Build.props src/BuildingBlocks/
COPY src/BuildingBlocks/TukiFact.BuildingBlocks.Contracts/TukiFact.BuildingBlocks.Contracts.csproj src/BuildingBlocks/TukiFact.BuildingBlocks.Contracts/
COPY src/BuildingBlocks/TukiFact.Contracts.Grpc/TukiFact.Contracts.Grpc.csproj src/BuildingBlocks/TukiFact.Contracts.Grpc/

# TukiFact.Contracts.Grpc compiles contracts/tukifact/v1/cpe.proto via a relative ProtoRoot, so the
# proto sources must exist at restore/build time too (Grpc.Tools resolves the Protobuf item during
# restore-adjacent design-time builds, not only at publish).
COPY contracts/ contracts/

# Restore
RUN dotnet restore src/TukiFact.Api/TukiFact.Api.csproj

# Copy source and build
COPY src/ src/
RUN dotnet publish src/TukiFact.Api/TukiFact.Api.csproj -c Release -o /app/publish

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install Kerberos lib (required by Npgsql for GSSAPI support)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgssapi-krb5-2 \
    && rm -rf /var/lib/apt/lists/*

# Security: non-root user
RUN groupadd --system tukifact && useradd --system --gid tukifact --create-home --shell /usr/sbin/nologin tukifact

# DataProtection keys directory (mount as volume to persist across restarts)
RUN mkdir -p /app/keys && chown tukifact:tukifact /app/keys
VOLUME /app/keys

USER tukifact

COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_DataProtection__KeyDirectory=/app/keys
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD bash -lc 'exec 3<>/dev/tcp/127.0.0.1/8080'

ENTRYPOINT ["dotnet", "TukiFact.Api.dll"]
