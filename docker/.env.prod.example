# TukiFact — production env example
# Copy to docker/.env.prod and fill every value marked __REQUIRED__.
# This file MUST NOT be committed. .env.prod itself is ignored via docker/.env*.

# === Postgres ===
PG_DATABASE=tukifact
PG_USER=tukifact
PG_PASSWORD=__REQUIRED__                          # strong random (32+ hex chars)

# === MinIO (S3-compatible object storage) ===
MINIO_USER=__REQUIRED__                           # admin user (8+ chars)
MINIO_PASSWORD=__REQUIRED__                       # admin password (16+ chars)

# === API / JWT ===
JWT_SECRET=__REQUIRED__                           # 256-bit random; rotate = invalidates sessions
ALLOWED_HOSTS=api.tukifact.com.pe
CORS_FRONTEND_URL=https://tukifact.com.pe,https://www.tukifact.com.pe,https://app.tukifact.com.pe
SUNAT_ENV=beta                                    # `beta` until SUNAT prod cert is uploaded

# === First-tenant seeding (runs only when Tenants table is empty) ===
SEED_ADMIN_EMAIL=administrations@tukisolutions.com
SEED_ADMIN_PASSWORD=Eth@N2505
SEED_ADMIN_NAME=Administracion TukiSolutions
SEED_TENANT_RUC=20613614509
SEED_TENANT_RAZON_SOCIAL=Tukituki Solutions SAC
SEED_SUPERADMIN_EMAIL=administrations@tukisolutions.com
SEED_SUPERADMIN_PASSWORD=Eth@N2505
SEED_SUPERADMIN_NAME=Super Admin

# === Billing (Culqi) — fill once Culqi approves the account (~15 days post-launch) ===
CULQI_SECRET_KEY=
NEXT_PUBLIC_CULQI_PUBLIC_KEY=

# === Anti-bot (Cloudflare Turnstile, used in /contacto) ===
TURNSTILE_SECRET_KEY=                             # empty = skip verification
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                   # empty = hide widget

# === Observability ===
SENTRY_DSN=                                       # empty = Sentry no-op
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=tukifact.com.pe

# === Public URLs (baked into Next bundle at build time) ===
NEXT_PUBLIC_API_URL=https://api.tukifact.com.pe
NEXT_PUBLIC_PUBLIC_URL=https://tukifact.com.pe

# === Gateway (nginx-proxy + acme-companion) ===
LETSENCRYPT_EMAIL=jaimeandre17@hotmail.com

# === AI assistant ===
AI_PROVIDER=stub                                  # stub | openai | anthropic
AI_API_KEY=
AI_MODEL=gpt-4o-mini
