<Project>

  <!-- ManagePackageVersionsCentrally is set in the root Directory.Build.props. -->

  <ItemGroup>
    <!-- Pinned at the versions that were already resolved before adopting CPM (no silent bumps). -->
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.71.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.5" />
    <!-- Bumped 10.0.3 -> 10.0.12, aligned with
         Microsoft.Extensions.ApiDescription.Server 10.0.12 below: the getdocument build-time tool
         bundles its own Microsoft.OpenApi 2.12.0, which must match the app's below or the tool
         process throws FileLoadException loading the app's assembly (mismatched strong name). -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.5" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <PackageVersion Include="Minio" Version="7.0.0" />
    <PackageVersion Include="NATS.Net" Version="2.7.3" />
    <PackageVersion Include="QuestPDF" Version="2026.2.4" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.13.20" />
    <PackageVersion Include="Sentry.AspNetCore" Version="6.6.0" />
    <!--
      Swashbuckle.AspNetCore was removed as unused (Scalar + Microsoft.AspNetCore.OpenApi serve
      the docs); without an explicit pin NuGet would downgrade this transitive dependency, so the
      version is pinned here and referenced directly from TukiFact.Api.csproj. Bumped 2.4.1 ->
      2.12.2 to match Microsoft.Extensions.ApiDescription.Server's bundled getdocument tool
      (see the Microsoft.AspNetCore.OpenApi comment above).
    -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.12.2" />
    <!-- Carries NU1903 (known high-severity advisory); root TreatWarningsAsErrors=false keeps it non-blocking. Bump is a separate, dedicated change. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.8" />
    <!--
      Bumped 8.1.0 -> 10.2.3: minimal-API versioning only
      (EndpointExtensions.AddEndpointVersioning/MapEndpoints), never MVC. Asp.Versioning.Mvc.ApiExplorer
      is removed below — verified zero [ApiVersion]/AddApiVersioning usages against the 33 legacy
      controllers, so it was already a dead reference.
    -->
    <PackageVersion Include="Asp.Versioning.Http" Version="10.2.3" />
    <!-- TukiFact.Api: dotnet build emits openapi/tukifact-api-v1.json. -->
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.12" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.12.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- Npgsql: was a floating "*" (build-break risk, ADR-001); pinned at the version it last resolved to. -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- FluentAssertions 7.x is the last Apache-2.0 line; 8+ is commercial. -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />

    <!-- xUnit v3 without Microsoft.Testing.Platform; rationale in tests/Directory.Build.props. -->
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.1" />

    <!-- Common.Application: custom mediator + FluentValidation pipeline behavior. -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <!-- Explicit pin of the transitive core so the DI extensions package cannot float it independently. -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <!-- Concrete DI container, needed only by TukiFact.Common.UnitTests to build a ServiceProvider in tests. -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />

    <!-- Common.Infrastructure: persistence (EF Core + Dapper) and the RLS tenant hook. -->
    <PackageVersion Include="Dapper" Version="2.1.86" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <!-- Must equal the transitive version Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3 resolves to (verified via dotnet list package). -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- Test-only: TukiFact.TestSupport needs xUnit v3 fixture/collection types without the full runner. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.1" />

    <!-- Common.Presentation: gRPC server surface. Grpc.AspNetCore.Server's
         own Google.Protobuf floor is 3.31.1 (verified via its nuspec); 3.36.1 here is a raise, not a
         downgrade. Grpc.StatusProto brings Google.Api.CommonProtos transitively for Google.Rpc.Status/Code. -->
    <PackageVersion Include="Grpc.AspNetCore.Server" Version="2.83.0" />
    <PackageVersion Include="Grpc.StatusProto" Version="2.83.0" />
    <!-- TukiFact.Contracts.Grpc: contract-first compilation of contracts/tukifact/v1/*.proto. -->
    <PackageVersion Include="Grpc.AspNetCore" Version="2.83.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.84.0" />
    <PackageVersion Include="Google.Protobuf" Version="3.36.1" />

    <!-- TukiFact.ArchitectureTests: layering, convention and self-check rules. -->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />

    <!-- Common.UnitTests: in-memory HTTP pipeline for CorrelationIdMiddleware/ProblemDetails tests.
         Not part of the Microsoft.AspNetCore.App ref-pack, unlike most ASP.NET Core types. -->
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.5" />
  </ItemGroup>

</Project>
