<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared test fixtures referenced by kernel integration test projects: container images, the
    generic Postgres container fixture and the module-integration fixture base. Not a test project
    itself (no KernelTestProject flag) — nothing here runs on its own.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Common\TukiFact.Common.Infrastructure\TukiFact.Common.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="xunit.v3.extensibility.core" />
  </ItemGroup>

</Project>
